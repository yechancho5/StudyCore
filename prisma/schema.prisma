// Prisma schema for StudyCore

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now())
  question     String?   // optional
  revealed     Boolean   @default(false)
  hostId       String
  answers      Answer[]
  participants User[]    @relation("RoomParticipants")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   // This is the localStorage userId (not globally unique)
  username  String
  roomId    String   @db.Uuid
  room      Room     @relation("RoomParticipants", fields: [roomId], references: [id], onDelete: Cascade)
  lastSeen  DateTime @default(now())
  answers   Answer[]
  createdAt DateTime @default(now())

  @@unique([userId, roomId]) // User can only be in one room at a time
}

model Answer {
  id        String   @id @default(uuid()) @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  username  String
  text      String
  // drawingData Json?   // Store Fabric.js drawing data as JSON - temporarily commented out
  timestamp DateTime @default(now())
  revealed  Boolean  @default(false)
}
